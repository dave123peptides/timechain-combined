# Copy this file to `.env` for local docker-compose development.
# NEVER put real secrets here or in any file committed to source control.
# In deployed environments (ECS/Fargate), these values are injected via
# AWS Secrets Manager / task definition environment variables instead.

# --- General ---
ENVIRONMENT=local
LOG_LEVEL=info

# --- PostgreSQL (local docker-compose only) ---
POSTGRES_USER=timechain
POSTGRES_PASSWORD=changeme-local-only
POSTGRES_DB=tcp
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full connection string used by services/api and services/worker
DATABASE_URL=postgresql+psycopg://timechain:changeme-local-only@db:5432/tcp

# --- FastAPI (services/api) ---
API_HOST=0.0.0.0
API_PORT=8100
# Every browser origin that calls the API (cart drawer, checkout, admin).
# PUBLIC_SITE_URL (bare + www) is appended automatically.
API_CORS_ORIGINS=http://localhost:3100
# Canonical storefront URL: order links in the Sheets/webhook payload,
# and auto-added to CORS. Must name the live domain in production.
PUBLIC_SITE_URL=http://localhost:3100
PUBLIC_SITE_LOGO_URL=
# Go-live safety switch. false: /shop/* presents an empty storefront and
# /checkout/* returns 503 — nothing else changes. Used to run production
# catalog/mapping work (e.g. a production supplier sync) before opening
# the storefront to real customers. Defaults true so local dev is
# unaffected; set explicitly false in production until go-live.
CHECKOUT_ENABLED=true
# Gates every /admin route on both the API (FastAPI HTTPBasic dependency,
# the real boundary) and the web app (Next middleware, defense-in-depth
# only — the admin page's JS calls the API directly, cross-origin). Fails
# closed: leaving either blank locks admin out rather than leaving it open.
# Same two values consumed by both services via this shared .env file.
ADMIN_BASIC_AUTH_USER=
ADMIN_BASIC_AUTH_PASSWORD=

# How a paid order reaches the supplier. "manual" (default): nothing is
# pushed — place it by hand from /admin/orders, the CSV export, or the
# webhook below. "supplier_api": the worker submits it automatically.
FULFILLMENT_MODE=manual
# Optional: every new order is POSTed here as JSON (e.g. a Zapier / Make
# catch-hook URL that appends a row to a Google Sheet).
ORDER_NOTIFY_WEBHOOK_URL=
# Google Sheets order feed: every new order is appended as a row to the
# named tab via a service account (docs/plans/google-sheets-order-feed.md).
# Blank spreadsheet id = feature off. GOOGLE_SERVICE_ACCOUNT_JSON is the
# full JSON key on one line; never commit a real key.
GOOGLE_SHEETS_ORDERS_SPREADSHEET_ID=
GOOGLE_SHEETS_ORDERS_TAB=Orders
GOOGLE_SERVICE_ACCOUNT_JSON=
# Fallback auth when the Google Workspace blocks service-account keys
# (org policy): one-line JSON {refresh_token, client_id, client_secret,
# token_uri} with spreadsheets scope. Used only if the SA key is blank.
GOOGLE_SHEETS_REFRESH_TOKEN_JSON=

# --- Next.js (apps/web) ---
# `next dev` does not read this file: put these four in apps/web/.env.local
# (gitignored) for local runs, or in the Vercel project env.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8100
# Server components inside Docker reach the API by service name instead.
API_INTERNAL_BASE_URL=http://localhost:8100
# Pre-launch password gate at /enter (apps/web/src/lib/access.ts).
SITE_ACCESS_PASSWORD=

# --- Worker (services/worker) ---
WORKER_POLL_INTERVAL_SECONDS=5
# "local" (Postgres-backed background_jobs table) or "sqs".
QUEUE_PROVIDER=local
# Same go-live safety switch as CHECKOUT_ENABLED, worker-side. false:
# the corresponding job handler logs and returns without ever calling
# AllianceTek (no order push / no tracking pull), and the job is still
# deleted as a normal success rather than retried forever.
SUPPLIER_PUSH_ENABLED=true
TRACKING_ENABLED=true

# --- AllianceTek Sandbox/Production API (services/worker/worker/alliancetek) ---
# Never put the real values here — set them in your local, git-ignored
# .env, or in AWS Secrets Manager for deployed environments.
SUPPLIER_API_PRODUCTS_URL=
# Not yet confirmed against the real AllianceTek sandbox — fill in once
# available. The client validates presence lazily, per-call, so the
# worker still boots without these.
SUPPLIER_API_ORDERS_URL=
SUPPLIER_API_ORDER_STATUS_URL=
SUPPLIER_API_FULFILLMENTS_URL=
SUPPLIER_API_SHIPMENTS_URL=
SUPPLIER_API_EMAIL=
SUPPLIER_API_TOKEN=

# Separate Production credentials — used only by
# `python -m worker.supplier_sync.production_report` (a read-only
# catalog comparison; never writes to supplier_products or any mapping
# table). Do NOT reuse the Sandbox values above — Production productIds
# are not the same numbering as Sandbox. Leave blank until you actually
# have real Production AllianceTek credentials.
SUPPLIER_API_PRODUCTION_PRODUCTS_URL=
SUPPLIER_API_PRODUCTION_EMAIL=
SUPPLIER_API_PRODUCTION_TOKEN=

# --- AWS (placeholders only — real values come from Secrets Manager in deployed envs) ---
AWS_REGION=us-east-1
# Populated once QUEUE_PROVIDER=sqs is actually used in a deployed environment.
SQS_QUEUE_URL=

# --- PayPal Checkout (services/api/app/payments/paypal.py; David, 9/13) ---
# Master switch. false (default): POST /checkout/create and retry-payment
# refuse payment_method "paypal"; the webhook route and the return
# capture keep settling PayPal orders that already exist.
PAYPAL_CHECKOUT_ENABLED=false
# REST app credentials from developer.paypal.com → Apps & Credentials.
# The Sandbox/Live tab must match PAYPAL_ENVIRONMENT. Blank = PayPal
# checkout degrades (order created, no approval link) and every PayPal
# webhook is rejected. Never commit real values.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_ENVIRONMENT=sandbox
# Id of the webhook pointing at <api>/api/v1/webhooks/payments/paypal
# (dashboard → Webhooks, or app.payments.paypal.register_webhook).
# Blank = every PayPal webhook is rejected 400.
PAYPAL_WEBHOOK_ID=
# Shown on PayPal's approval page next to the order number. Never a
# product name.
PAYPAL_BRAND_NAME=TCP
# Storefront copy of the switch (apps/web/.env.local or the Vercel
# project env): the checkout option renders "Coming soon" unless true.
NEXT_PUBLIC_PAYPAL_CHECKOUT_ENABLED=false
